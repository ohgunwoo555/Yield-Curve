# Supabase Postgres 연결 문자열 (Transaction pooler, port 6543)
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# (선택) 마이그레이션(pnpm db:migrate) 전용. Session pooler, port 5432 주소.
# 비워 두면 DATABASE_URL을 사용한다.
DIRECT_URL=

# https://fred.stlouisfed.org/docs/api/api_key.html 에서 발급
FRED_API_KEY=

# https://ecos.bok.or.kr (마이페이지 > 인증키 신청) 에서 발급
ECOS_API_KEY=

# 크론 엔드포인트 보호용 랜덤 문자열 (예: openssl rand -hex 32)
CRON_SECRET=
